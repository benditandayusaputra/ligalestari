# Salin menjadi .env lalu isi nilainya.

# Koneksi Neon (Postgres): ambil dari dashboard Neon → Connection string.
# Dipakai server saja; jangan pernah dikirim ke browser.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Password enkripsi cookie sesi login (min. 32 karakter acak)
# Nilai di bawah acak dan khusus demo lokal; ganti dengan milikmu saat deploy.
NUXT_SESSION_PASSWORD=MjQpVAtXq_192eqNC2ZR96BTBlKDo8F08MoQKo6ALXExkex4

# URL situs untuk canonical/sitemap saat deploy
NUXT_PUBLIC_SITE_URL=https://ligalestari.vercel.app

# LLM Asisten Hijau lewat endpoint OpenAI-compatible (Gemini, OpenAI, Groq, dll).
# Demo langsung tersedia di situs live (lihat README); kunci ini hanya untuk jalan lokal.
# Nilainya dibaca saat build, jadi setiap perubahan menuntut build ulang (atau redeploy).
# Model lite dipilih karena kuota harian tingkat gratis jauh lebih longgar dan balasannya cepat.
AI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_LLM_API_KEY=isi-dengan-kunci-dari-https://aistudio.google.com/apikey
AI_LLM_MODEL=gemini-3.1-flash-lite
