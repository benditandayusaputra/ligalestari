# Salin menjadi .env lalu isi nilainya (Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxx
SUPABASE_SERVICE_KEY=sb_secret_xxxx

# Password enkripsi cookie sesi login (min. 32 karakter acak)
NUXT_SESSION_PASSWORD=isi-dengan-string-acak-minimal-32-karakter

# URL situs untuk canonical/sitemap saat deploy
NUXT_PUBLIC_SITE_URL=https://ligalestari.vercel.app
